generator client {
  provider = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LedgerEntry {
  id                  String             @id @default(uuid())
  userId              String
  walletAddr          String
  network             LedgerNetwork      @default(XRPL)
  operation           LedgerOperation

  amountAtomic        Decimal            @db.Decimal(38, 0)
  amountDisplay       Decimal            @db.Decimal(38, 6)
  currencyCode        String             @default("VAKS")

  idempotencyKey      String
  sourceEventId       String?
  sourceTransactionId String?
  correlationId       String?

  status              LedgerStatus       @default(QUEUED)
  txHash              String?
  providerSequence    String?
  blockOrLedgerIndex  Int?

  submitAttempts      Int                @default(0)
  nextRetryAt         DateTime?
  lastErrorCode       String?
  lastErrorMessage    String?

  metadata            Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  confirmedAt         DateTime?

  reconciliationJobs  ReconciliationJob[]

  @@unique([idempotencyKey, operation, network])
  @@index([userId, createdAt])
  @@index([walletAddr, createdAt])
  @@index([sourceTransactionId])
  @@index([status, nextRetryAt])
  @@index([txHash])
}

model LedgerOutbox {
  id              String           @id @default(uuid())
  stream          String
  event           String
  partitionKey    String?
  payload         Json

  dedupeKey       String?          @unique
  status          OutboxStatus      @default(PENDING)
  attempts        Int               @default(0)
  nextAttemptAt   DateTime?
  lastError       String?

  createdAt       DateTime          @default(now())
  publishedAt     DateTime?

  @@index([status, nextAttemptAt])
  @@index([stream, event, createdAt])
}

model ReconciliationJob {
  id                  String               @id @default(uuid())
  ledgerEntryId       String
  ledgerEntry         LedgerEntry          @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)

  reason              ReconciliationReason
  status              ReconciliationStatus @default(PENDING)
  attempts            Int                  @default(0)
  nextAttemptAt       DateTime?

  resultSnapshot      Json?
  lastErrorCode       String?
  lastErrorMessage    String?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  resolvedAt          DateTime?

  @@index([status, nextAttemptAt])
  @@index([ledgerEntryId, status])
}

model WalletMapping {
  id         String   @id @default(uuid())
  userId     String   @unique
  walletAddr String   @unique
  network    LedgerNetwork @default(XRPL)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum LedgerNetwork {
  EVM
  XRPL
}

enum LedgerOperation {
  MINT
  TRANSFER
  BURN
}

enum LedgerStatus {
  QUEUED
  SUBMITTED
  CONFIRMED
  FAILED
  COMPENSATED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum ReconciliationStatus {
  PENDING
  RUNNING
  RESOLVED
  FAILED
}

enum ReconciliationReason {
  PENDING_TIMEOUT
  RETRYABLE_PROVIDER_ERROR
  MANUAL_REPAIR
  PERIODIC_AUDIT
}
